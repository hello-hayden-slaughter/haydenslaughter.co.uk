---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { caseStudies } from '../../data/caseStudies';
---

<BaseLayout
  title="The work — Hayden Slaughter"
  description="Two case studies from Hayden Slaughter: building the product function and strategy at Powernaut, and the product, team and #1-rated app at Indra."
>
  <SiteNav />

  <main class="container work">
    <header class="work__head">
      <p class="eyebrow">The work</p>
      <h1>Two places I walked into something unshaped and left it clearer, more useful, and owned by the team.</h1>
      <p class="measure work__intro">
        Scannable first, deep on demand. The same move in two companies, at different stages.
      </p>
    </header>

    <div class="work__cards">
      {
        caseStudies.map((cs) => (
          <a class="wcard" href={`/work/${cs.slug}`}>
            <div class="wcard__top">
              <span class="wcard__name">{cs.name}</span>
              <span class="wcard__kind">{cs.kind} · {cs.period}</span>
            </div>
            <p class="wcard__summary">{cs.summary}</p>
            <div class="wcard__tags">
              {cs.tags.map((t) => (
                <span class="wcard__tag">{t}</span>
              ))}
            </div>
            <span class="wcard__cta">Read the story →</span>
          </a>
        ))
      }
    </div>
  </main>

  <SiteFooter />

  <style>
    .work {
      padding-block: var(--space-7);
    }
    .work__head h1 {
      margin: 10px 0 0;
      max-width: 20ch;
    }
    .work__intro {
      margin: 16px 0 0;
      font-size: 17px;
      line-height: 1.6;
      color: var(--grey-3);
    }
    .work__cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-5);
    }
    .wcard {
      display: flex;
      flex-direction: column;
      border: var(--border);
      background: var(--surface-card);
      box-shadow: var(--shadow-hard);
      padding: 28px 26px;
      text-decoration: none;
      color: var(--ink);
      transition: transform 120ms ease, box-shadow 120ms ease;
    }
    .wcard:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 rgba(22, 19, 14, 0.85);
      color: var(--ink);
    }
    .wcard__top {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .wcard__name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 24px;
      letter-spacing: -0.02em;
    }
    .wcard__kind {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--grey-2);
    }
    .wcard__summary {
      margin: 16px 0 0;
      font-size: 15px;
      line-height: 1.6;
      color: var(--grey-3);
      flex: 1;
    }
    .wcard__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 18px 0 0;
    }
    .wcard__tag {
      font-family: var(--font-mono);
      font-size: 11px;
      border: var(--border-thin);
      padding: 4px 9px;
    }
    .wcard__cta {
      margin-top: 20px;
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--teal);
    }
    .wcard:hover .wcard__cta {
      color: var(--red);
    }
  </style>
</BaseLayout>
