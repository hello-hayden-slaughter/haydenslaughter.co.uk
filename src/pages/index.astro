---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cv } from '../data/cv';
---

<BaseLayout
  title="Hayden Slaughter — Head of Product & Design"
  description="Hayden Slaughter, Head of Product & Design. Zero-to-one product leader, AI-native, Brighton. First product hire at Powernaut and Indra; two AI products shipped solo."
>
  <SiteNav />

  <main class="page">
    <div class="toolbar">
      <a class="dl" href="/Hayden-Slaughter-CV.pdf" download>
        <span class="dl__icon">↓</span> Download CV (PDF)
      </a>
    </div>

    <article class="sheet">
      <header class="sheet__head">
        <div class="sheet__kicker">
          <span>{cv.kicker}</span>
          <span class="sheet__tag">NORMAL.CV</span>
        </div>
        <h1>{cv.name}</h1>
        <p class="sheet__contact">
          {cv.contact.location}
          <span class="dot">·</span>
          <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
          <span class="dot">·</span>
          <a href={cv.contact.linkedin.href}>{cv.contact.linkedin.label}</a>
        </p>
        <p class="sheet__summary">{cv.summary}</p>
      </header>

      <section class="sheet__body">
        <p class="sheet__label">EXPERIENCE</p>
        {
          cv.experience.map((role) => (
            <div class="role">
              <div class="role__meta">
                <span class="role__period">{role.period}</span>
                {role.meta.map((m) => (
                  <span class="role__metaline">{m}</span>
                ))}
              </div>
              <div class="role__main">
                <h2>
                  {role.role}
                  {role.org && <span class="role__org"> · {role.org}</span>}
                </h2>
                {role.blurb && <p class="role__blurb">{role.blurb}</p>}
                {role.bullets && (
                  <ul class="role__bullets">
                    {role.bullets.map((b) => (
                      <li>
                        <span class="bullet" />
                        <span set:html={b} />
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))
        }
      </section>

      <section class="sheet__ai">
        <p class="sheet__label sheet__label--yellow">INDEPENDENT AI PRODUCTS · SHIPPED, PUBLIC</p>
        <div class="ai-grid">
          {
            cv.aiProducts.map((p) => (
              <div class="ai-card">
                <div class="ai-card__top">
                  <span class="ai-card__name">{p.name}</span>
                  <span class="ai-card__status">{p.status}</span>
                </div>
                <p class="ai-card__kind">{p.kind}</p>
                <p class="ai-card__body">{p.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="sheet__foot">
        <p class="sheet__label">SKILLS</p>
        <div class="chips">
          {cv.skills.map((s) => <span class="chip">{s}</span>)}
        </div>
        <div class="two-up">
          <div>
            <p class="sheet__label">EDUCATION</p>
            {
              cv.education.map((e) => (
                <p class="edu">
                  <strong>{e.degree}</strong>
                  <br />
                  {e.place}
                </p>
              ))
            }
          </div>
          <div>
            <p class="sheet__label">OUTSIDE WORK</p>
            <p class="edu">{cv.outsideWork}</p>
          </div>
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />

  <style>
    .page {
      padding: var(--space-5) var(--space-3) var(--space-7);
      display: flex;
      flex-direction: column;
      align-items: center;
      background: var(--canvas);
    }
    .toolbar {
      width: 790px;
      max-width: 100%;
      display: flex;
      justify-content: flex-end;
      margin-bottom: var(--space-2);
    }
    .dl {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: var(--paper);
      background: var(--ink);
      border: var(--border);
      box-shadow: var(--shadow-hard-sm);
      padding: 10px 16px;
      text-decoration: none;
    }
    .dl:hover {
      background: var(--teal);
      color: var(--paper);
    }
    .dl__icon {
      font-size: 15px;
    }

    .sheet {
      width: 790px;
      max-width: 100%;
      background: var(--paper);
      border: var(--border);
      box-shadow: var(--shadow-hard-lg);
      box-sizing: border-box;
    }
    .sheet__head {
      padding: 56px 64px 0;
    }
    .sheet__kicker {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
    }
    .sheet__kicker > span:first-child {
      font-family: var(--font-mono);
      font-size: 11.5px;
      font-weight: 500;
      letter-spacing: 0.14em;
      color: var(--ink);
    }
    .sheet__tag {
      font-family: var(--font-label);
      font-size: 9px;
      color: var(--red);
      flex: none;
    }
    .sheet__head h1 {
      margin: 16px 0 0;
      font-size: 42px;
      line-height: 0.98;
      letter-spacing: -0.03em;
    }
    .sheet__contact {
      margin: 14px 0 0;
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.7;
      color: var(--grey-3);
    }
    .sheet__contact a {
      color: inherit;
      text-decoration: none;
    }
    .sheet__contact a:hover {
      color: var(--red);
    }
    .sheet__contact .dot {
      color: var(--grey-1);
      padding: 0 2px;
    }
    .sheet__summary {
      margin: 28px 0 0;
      padding: 2px 0 2px 16px;
      border-left: 4px solid var(--teal);
      font-size: 16px;
      line-height: 1.65;
      max-width: 66ch;
    }
    .sheet__body {
      padding: 38px 64px 40px;
    }
    .sheet__label {
      margin: 0 0 20px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--grey-2);
    }
    .sheet__label--yellow {
      color: var(--yellow);
      font-family: var(--font-label);
    }
    .role {
      border-top: 2px solid var(--ink);
      padding: 22px 0 26px;
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 28px;
    }
    .role__meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
    .role__period {
      font-family: var(--font-mono);
      font-size: 11px;
      background: var(--ink);
      color: var(--mint);
      padding: 4px 10px;
    }
    .role__metaline {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.5;
      color: var(--grey-3);
    }
    .role__main h2 {
      margin: 0;
      font-size: 20px;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .role__org {
      color: var(--teal);
    }
    .role__blurb {
      margin: 12px 0 0;
      font-size: 15px;
      line-height: 1.6;
    }
    .role__bullets {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 14px 0 0;
    }
    .role__bullets li {
      display: flex;
      gap: 14px;
      align-items: baseline;
      font-size: 14.5px;
      line-height: 1.6;
    }
    .bullet {
      width: 7px;
      height: 7px;
      background: var(--teal);
      flex: none;
      transform: translateY(-1px);
    }
    .sheet__ai {
      padding: 36px 64px 42px;
      background: var(--ink);
      color: var(--paper);
    }
    .ai-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    .ai-card {
      border: 2px solid var(--paper);
      padding: 18px 22px;
    }
    .ai-card__top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .ai-card__name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 19px;
      letter-spacing: -0.02em;
    }
    .ai-card__status {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--mint);
    }
    .ai-card__kind {
      margin: 6px 0 0;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--grey-1);
    }
    .ai-card__body {
      margin: 12px 0 0;
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--grey-1);
    }
    .sheet__foot {
      padding: 34px 64px 42px;
    }
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .chip {
      font-family: var(--font-mono);
      font-size: 11px;
      border: var(--border-thin);
      padding: 4px 10px;
    }
    .two-up {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      margin: 30px 0 0;
    }
    .edu {
      margin: 0 0 12px;
      font-size: 14px;
      line-height: 1.6;
    }
    .edu strong {
      font-family: var(--font-display);
      font-weight: 700;
    }

    @media (max-width: 640px) {
      .toolbar {
        justify-content: stretch;
      }
      .dl {
        width: 100%;
        justify-content: center;
      }
      .sheet__head,
      .sheet__body,
      .sheet__ai,
      .sheet__foot {
        padding-left: 24px;
        padding-right: 24px;
      }
      .role,
      .ai-grid,
      .two-up {
        grid-template-columns: 1fr;
      }
      .sheet__head h1 {
        font-size: 34px;
      }
    }
  </style>
</BaseLayout>
