---
import BaseLayout from '../layouts/BaseLayout.astro';

const bootLines = [
  'SLAUGHTER OS v0.1',
  'Copyright (c) Hayden Slaughter',
  '',
  'Detecting hardware ............. OK',
  'Mounting portfolio ............. OK',
  'Loading design system .......... OK',
  'Starting window manager ........ PENDING',
  '',
  'System coming online. Check back soon.',
];
---

<BaseLayout title="Hayden Slaughter — Product Builder">
  <main class="stage">
    <div class="crt">
      <pre class="boot">{bootLines.join('\n')}<span class="cursor"></span></pre>
    </div>
  </main>

  <style>
    .stage {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      background: var(--teal);
      padding: var(--space-3);
    }
    .crt {
      width: min(560px, 100%);
      background: var(--ink);
      border: var(--border);
      box-shadow: var(--shadow-hard-lg);
    }
    .boot {
      margin: 0;
      padding: var(--space-3) var(--space-3);
      font-family: var(--font-label);
      font-size: var(--text-small);
      line-height: 1.9;
      color: var(--mint);
      white-space: pre-wrap;
      word-break: break-word;
    }
    .cursor {
      display: inline-block;
      width: 9px;
      height: 15px;
      margin-left: 4px;
      background: var(--mint);
      vertical-align: middle;
      animation: blink 1.1s step-end infinite;
    }
    @keyframes blink {
      0%,
      49% {
        opacity: 1;
      }
      50%,
      100% {
        opacity: 0;
      }
    }
  </style>
</BaseLayout>
