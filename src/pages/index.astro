---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cv } from '../data/cv';
---

<BaseLayout
  title="Hayden Slaughter — Head of Product & Design"
  description="Hayden Slaughter, Head of Product & Design. Zero-to-one product leader, AI-native, Brighton. First product hire at Powernaut and Indra; two AI products shipped solo."
>
  <SiteNav />

  <main>
    <header class="cv-head">
      <div class="container">
        <p class="cv-kicker">{cv.kicker}</p>
        <h1 class="cv-name">{cv.name}</h1>
        <p class="cv-contact">
          {cv.contact.location}
          <span class="dot">·</span>
          <a href={cv.contact.phone.href}>{cv.contact.phone.label}</a>
          <span class="dot">·</span>
          <a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
          <span class="dot">·</span>
          <a href={cv.contact.linkedin.href}>{cv.contact.linkedin.label}</a>
        </p>
        <p class="cv-summary measure">{cv.summary}</p>
        <a class="dl" href="/Hayden-Slaughter-CV.pdf" download>
          <span class="dl__icon">↓</span> Download CV (PDF)
        </a>
      </div>
    </header>

    <div class="container cv-body">
      <section class="block">
        <p class="eyebrow">Experience</p>
        <div class="roles">
          {
            cv.experience.map((role) => (
              <div class="role">
                <div class="role__meta">
                  <span class="role__period">{role.period}</span>
                  {role.meta.map((m) => (
                    <span class="role__metaline" set:html={m} />
                  ))}
                </div>
                <div class="role__main">
                  <h2>
                    {role.role}
                    {role.org && <span class="role__org"> · {role.org}</span>}
                  </h2>
                  {role.blurb && <p class="role__blurb">{role.blurb}</p>}
                  {role.bullets && (
                    <ul class="role__bullets">
                      {role.bullets.map((b) => (
                        <li>
                          <span class="bullet" />
                          <span set:html={b} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <section class="ai-band">
      <div class="container">
        <p class="eyebrow eyebrow--yellow">Independent AI products · shipped, public</p>
        <div class="ai-grid">
          {
            cv.aiProducts.map((p) => (
              <div class="ai-card">
                <div class="ai-card__top">
                  <span class="ai-card__name">{p.name}</span>
                  <span class="ai-card__status">{p.status}</span>
                </div>
                <p class="ai-card__kind">{p.kind}</p>
                <p class="ai-card__body">{p.body}</p>
                {
                  p.links && (
                    <div class="ai-card__links">
                      {p.links.map((l) => (
                        <a href={l.href} target="_blank" rel="noopener">
                          {l.label} ↗
                        </a>
                      ))}
                    </div>
                  )
                }
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <div class="container cv-body">
      <section class="block">
        <p class="eyebrow">Skills</p>
        <div class="chips">
          {cv.skills.map((s) => <span class="chip">{s}</span>)}
        </div>
      </section>

      <section class="block two-up">
        <div>
          <p class="eyebrow">Education</p>
          {
            cv.education.map((e) => (
              <p class="edu">
                <strong>{e.degree}</strong>
                <br />
                {e.place}
              </p>
            ))
          }
        </div>
        <div>
          <p class="eyebrow">Outside work</p>
          <p class="edu">{cv.outsideWork}</p>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />

  <style>
    /* ── Hero (full-width, like the case studies) ───────── */
    .cv-head {
      background: var(--ink);
      color: var(--paper);
      padding-block: var(--space-7) var(--space-5);
    }
    .cv-kicker {
      margin: 0;
      font-family: var(--font-mono);
      font-size: 11.5px;
      letter-spacing: 0.14em;
      color: var(--mint);
    }
    .cv-name {
      margin: 16px 0 0;
      color: var(--paper);
      font-size: clamp(40px, 7vw, 68px);
      line-height: 0.98;
      letter-spacing: -0.03em;
    }
    .cv-contact {
      margin: 16px 0 0;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.7;
      color: var(--grey-1);
    }
    .cv-contact a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid var(--grey-3);
    }
    .cv-contact a:hover {
      color: var(--mint);
    }
    .cv-contact .dot {
      color: var(--grey-3);
      padding: 0 4px;
    }
    .cv-summary {
      margin: 24px 0 0;
      font-size: clamp(17px, 2.2vw, 20px);
      line-height: 1.6;
      color: var(--paper);
    }
    .dl {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: var(--space-3);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      background: var(--mint);
      border: 2px solid var(--mint);
      padding: 11px 18px;
      text-decoration: none;
    }
    .dl:hover {
      background: var(--paper);
      border-color: var(--paper);
      color: var(--ink);
    }

    /* ── Body ───────────────────────────────────────────── */
    .cv-body {
      padding-block: var(--space-5);
    }
    .block + .block {
      margin-top: var(--space-7);
    }

    .roles {
      margin-top: var(--space-3);
    }
    .role {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 32px;
      padding: var(--space-5) 0;
      border-top: var(--border);
    }
    .role:first-child {
      padding-top: var(--space-2);
    }
    .role__meta {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
    .role__period {
      font-family: var(--font-mono);
      font-size: 11px;
      background: var(--ink);
      color: var(--mint);
      padding: 5px 10px;
    }
    .role__metaline {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.5;
      color: var(--grey-3);
    }
    .role__main h2 {
      margin: 0;
      font-size: clamp(20px, 2.6vw, 24px);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .role__org {
      color: var(--teal);
    }
    .role__blurb {
      margin: 14px 0 0;
      font-size: 16px;
      line-height: 1.6;
      max-width: 62ch;
    }
    .role__bullets {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 16px 0 0;
      max-width: 66ch;
    }
    .role__bullets li {
      display: flex;
      gap: 14px;
      align-items: baseline;
      font-size: 15px;
      line-height: 1.6;
    }
    .bullet {
      width: 7px;
      height: 7px;
      background: var(--teal);
      flex: none;
      transform: translateY(-1px);
    }

    /* ── AI band (full-width) ───────────────────────────── */
    .ai-band {
      background: var(--ink);
      color: var(--paper);
      padding-block: var(--space-7);
    }
    .eyebrow--yellow {
      color: var(--yellow);
    }
    .ai-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }
    .ai-card {
      border: 2px solid var(--paper);
      padding: 24px 26px;
    }
    .ai-card__top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .ai-card__name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 22px;
      letter-spacing: -0.02em;
    }
    .ai-card__status {
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--mint);
    }
    .ai-card__kind {
      margin: 6px 0 0;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--grey-1);
    }
    .ai-card__body {
      margin: 14px 0 0;
      font-size: 14px;
      line-height: 1.65;
      color: var(--grey-1);
    }
    .ai-card__links {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px 18px;
    }
    .ai-card__links a {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--mint);
      text-decoration: none;
      border-bottom: 1px solid var(--grey-4);
      padding-bottom: 2px;
    }
    .ai-card__links a:hover {
      color: var(--paper);
      border-color: var(--paper);
    }
    .role__metaline :global(a) {
      color: var(--teal);
      text-decoration: none;
      border-bottom: 1px solid var(--grey-1);
    }
    .role__metaline :global(a:hover) {
      color: var(--red);
    }

    /* ── Skills / education ─────────────────────────────── */
    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: var(--space-3);
    }
    .chip {
      font-family: var(--font-mono);
      font-size: 12px;
      border: var(--border-thin);
      padding: 5px 12px;
    }
    .two-up {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .two-up .eyebrow {
      margin-bottom: 12px;
    }
    .edu {
      margin: 0 0 14px;
      font-size: 15px;
      line-height: 1.6;
      max-width: 46ch;
    }
    .edu strong {
      font-family: var(--font-display);
      font-weight: 700;
    }

    @media (max-width: 680px) {
      .role {
        grid-template-columns: 1fr;
        gap: 14px;
      }
      .role__meta {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
      }
      .ai-grid,
      .two-up {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
