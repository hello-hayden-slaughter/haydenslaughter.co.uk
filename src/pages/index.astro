---
const bootLines = [
  'SLAUGHTER OS v0.1',
  'Copyright (c) Hayden Slaughter',
  '',
  'Detecting hardware ............. OK',
  'Mounting portfolio ............. OK',
  'Loading design system .......... OK',
  'Starting window manager ........ PENDING',
  '',
  'System coming online. Check back soon.',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Hayden Slaughter — Product Builder</title>
    <meta
      name="description"
      content="Portfolio of Hayden Slaughter, a zero-to-one product builder in Brighton. Site under construction."
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <pre class="boot">{bootLines.join('\n')}<span class="cursor"></span></pre>
    </main>

    <style>
      :root {
        --teal: #1e7a72;
        --ink: #16130e;
        --cream: #fffdf0;
        --green: #7ce3a8;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: var(--teal);
        color: var(--ink);
        font-family: Verdana, Geneva, sans-serif;
        padding: 24px;
      }
      main {
        width: min(560px, 100%);
        background: var(--ink);
        border: 2px solid var(--ink);
        box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.35);
      }
      .boot {
        margin: 0;
        padding: 28px 26px;
        font-family: 'Silkscreen', 'Courier New', monospace;
        font-size: 13px;
        line-height: 1.9;
        color: var(--green);
        white-space: pre-wrap;
        word-break: break-word;
      }
      .cursor {
        display: inline-block;
        width: 9px;
        height: 15px;
        margin-left: 4px;
        background: var(--green);
        vertical-align: middle;
        animation: blink 1.1s step-end infinite;
      }
      @keyframes blink {
        0%, 49% { opacity: 1; }
        50%, 100% { opacity: 0; }
      }
    </style>
  </body>
</html>
