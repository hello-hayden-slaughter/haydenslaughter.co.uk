---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { caseStudies } from '../../data/caseStudies';
---

<BaseLayout
  title="Portfolio — Hayden Slaughter"
  description="Two case studies from Hayden Slaughter: building the product function, team and #1-rated app at Indra, and the strategy the whole business runs on at Powernaut."
>
  <SiteNav />

  <main class="container portfolio">
    <header class="portfolio__head">
      <p class="eyebrow">Selected work · two case studies</p>
      <h1>Two places I walked into something unshaped and left it clearer, more useful, and owned by the team.</h1>
      <a class="dl" href="/Hayden-Slaughter-Portfolio.pdf" download>
        <span class="dl__icon">↓</span> Download portfolio (PDF)
      </a>
    </header>

    <div class="portfolio__cards">
      {
        caseStudies.map((cs) => (
          <a class="pcard" href={`/portfolio/${cs.slug}`}>
            <div class="pcard__media">
              <img src={cs.cardImage} alt={cs.hero?.alt ?? cs.name} loading="lazy" />
            </div>
            <div class="pcard__body">
              <div class="pcard__top">
                <span class="pcard__name">{cs.name}</span>
                <span class="pcard__kind">{cs.roleTitle} · {cs.kind} · {cs.period}</span>
              </div>
              <p class="pcard__summary">{cs.summary}</p>
              <div class="pcard__tags">
                {cs.tags.map((t) => (
                  <span class="pcard__tag">{t}</span>
                ))}
              </div>
              <span class="pcard__cta">Read the case study →</span>
            </div>
          </a>
        ))
      }
    </div>
  </main>

  <SiteFooter />

  <style>
    .portfolio {
      padding-block: var(--space-7);
    }
    .portfolio__head h1 {
      margin: 10px 0 0;
    }
    .dl {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: var(--space-3);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: var(--paper);
      background: var(--ink);
      border: var(--border);
      box-shadow: var(--shadow-hard-sm);
      padding: 10px 16px;
      text-decoration: none;
    }
    .dl:hover {
      background: var(--teal);
      color: var(--paper);
    }
    .portfolio__cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-5);
    }
    .pcard {
      display: flex;
      flex-direction: column;
      border: var(--border);
      background: var(--surface-card);
      box-shadow: var(--shadow-hard);
      text-decoration: none;
      color: var(--ink);
      overflow: hidden;
      transition: transform 120ms ease, box-shadow 120ms ease;
    }
    .pcard:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 rgba(22, 19, 14, 0.85);
    }
    .pcard__media {
      aspect-ratio: 16 / 9;
      border-bottom: var(--border);
      overflow: hidden;
      background: var(--canvas);
    }
    .pcard__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .pcard__body {
      padding: 24px 24px 26px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .pcard__name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 24px;
      letter-spacing: -0.02em;
    }
    .pcard__kind {
      display: block;
      margin-top: 4px;
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--grey-2);
    }
    .pcard__summary {
      margin: 14px 0 0;
      font-size: 15px;
      line-height: 1.6;
      color: var(--grey-3);
      flex: 1;
    }
    .pcard__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 16px 0 0;
    }
    .pcard__tag {
      font-family: var(--font-mono);
      font-size: 11px;
      border: var(--border-thin);
      padding: 3px 9px;
    }
    .pcard__cta {
      margin-top: 18px;
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--teal);
    }
    .pcard:hover .pcard__cta {
      color: var(--red);
    }
  </style>
</BaseLayout>
