---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { caseStudies, type Figure, type Img } from '../../data/caseStudies';

// Powernaut is diagram-led; its figures are inline SVG/HTML lifted from source.
import pnFig1 from '../../diagrams/powernaut/fig1.html?raw';
import pnFig2 from '../../diagrams/powernaut/fig2.html?raw';
import pnFig3 from '../../diagrams/powernaut/fig3.html?raw';
import pnFig4 from '../../diagrams/powernaut/fig4.html?raw';
import pnFig5 from '../../diagrams/powernaut/fig5.html?raw';
import pnFig6 from '../../diagrams/powernaut/fig6.html?raw';
import pnFig7 from '../../diagrams/powernaut/fig7.html?raw';

const powernautDiagrams: Record<number, string[]> = {
  0: [pnFig1],
  1: [pnFig2],
  2: [pnFig3],
  3: [pnFig4, pnFig5],
  4: [pnFig6],
  5: [pnFig7],
};

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props;
const diagramsFor = (idx: number): string[] =>
  cs.slug === 'powernaut' ? (powernautDiagrams[idx] ?? []) : [];

const cellStyle = (im: Img) =>
  [im.bg ? `background:${im.bg}` : '', im.fit ? `object-fit:${im.fit}` : ''].filter(Boolean).join(';');

const depthCards = cs.depth?.filter((d) => d.image) ?? [];
const depthNotes = cs.depth?.filter((d) => !d.image) ?? [];
---

<BaseLayout title={`${cs.name} — Hayden Slaughter`} description={cs.oneLiner}>
  <SiteNav />

  <main>
    <header class="cs-head">
      <div class="container">
        <p class="eyebrow"><a href="/portfolio" class="cs-back">← Portfolio</a></p>
        <p class="cs-kind">{cs.roleTitle} · {cs.name} · {cs.kind} · {cs.period}</p>
        <h1 class="cs-oneliner">{cs.oneLiner}</h1>
        <p class="cs-standfirst measure">{cs.standfirst}</p>
        <a class="dl" href="/Hayden-Slaughter-Portfolio.pdf" download>
          <span class="dl__icon">↓</span> Download portfolio (PDF)
        </a>
      </div>
    </header>

    {
      cs.hero && (
        <div class="container cs-hero-wrap">
          <div class="cs-hero">
            <img src={cs.hero.src} alt={cs.hero.alt} />
          </div>
        </div>
      )
    }

    <div class="container cs-body">
      <section class="whatibuilt">
        <p class="eyebrow">What I built</p>
        <ul>
          {cs.whatIBuilt.map((w) => <li>{w}</li>)}
        </ul>
      </section>

      {
        cs.beats.map((beat, i) => (
          <section class="beat">
            <div class="beat__head">
              <span class="beat__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="beat__title">{beat.title}</h2>
                <p class="beat__subhead">{beat.subhead}</p>
              </div>
            </div>
            <div class="beat__body measure">
              {beat.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            {beat.quote && (
              <figure class="pull">
                <blockquote>{beat.quote.text}</blockquote>
                {beat.quote.attrib && <figcaption>{beat.quote.attrib}</figcaption>}
                {beat.quote.note && <p class="pull__note">{beat.quote.note}</p>}
              </figure>
            )}

            {beat.figures?.map((fig: Figure) => (
              <figure class="fig">
                {fig.layout === 'band' && (
                  <div class="fig__band">
                    <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                  </div>
                )}

                {fig.layout === 'grid' && (
                  <div class="fig__grid" style={`--cols:${fig.cols ?? '1fr 1fr'}`}>
                    {fig.imgs.map((im) => (
                      <div class="fig__cell" style={im.bg ? `background:${im.bg}` : ''}>
                        <img src={im.src} alt={im.alt} style={cellStyle(im)} loading="lazy" decoding="async" />
                      </div>
                    ))}
                  </div>
                )}

                {fig.layout === 'frame' && (
                  <div class="fig__frame">
                    <div class="fig__framepad">
                      <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                    </div>
                  </div>
                )}

                {fig.layout === 'photo-quote' && (
                  <div class="fig__pq" style={`--cols:${fig.cols ?? '0.55fr 1fr'}`}>
                    <div class="fig__pqimg">
                      <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                    </div>
                    <blockquote class="fig__pqquote">
                      <p class="fig__pqtext">{fig.quote?.text}</p>
                      {fig.quote?.attrib && <p class="fig__pqattrib">{fig.quote.attrib}</p>}
                      {fig.quote?.note && <p class="fig__pqnote">{fig.quote.note}</p>}
                    </blockquote>
                  </div>
                )}

                {fig.caption && <figcaption>{fig.caption}</figcaption>}
              </figure>
            ))}

            {diagramsFor(i).map((d) => <div class="pn-figure" set:html={d} />)}
          </section>
        ))
      }

      {
        cs.depth && cs.depth.length > 0 && (
          <section class="depth">
            <h2 class="depth__title">{cs.depthHeading}</h2>
            {depthCards.length > 0 && (
              <div class="depth__cards">
                {depthCards.map((d) => (
                  <div class="dcard">
                    <div class="dcard__img">
                      <img src={d.image!.src} alt={d.image!.alt} loading="lazy" decoding="async" />
                    </div>
                    <p class="dcard__body">{d.body}</p>
                  </div>
                ))}
              </div>
            )}
            {depthNotes.length > 0 && (
              <div class="depth__notes">
                {depthNotes.map((d) => (
                  <p class="measure">{d.body}</p>
                ))}
              </div>
            )}
          </section>
        )
      }

      <nav class="cs-next">
        <a href="/portfolio">← Portfolio</a>
        <a href="/">The CV →</a>
      </nav>
    </div>
  </main>

  <SiteFooter />

  <style>
    /* ── Header ─────────────────────────────────────────── */
    .cs-head {
      background: var(--ink);
      color: var(--paper);
      padding-block: var(--space-7) var(--space-5);
    }
    .cs-back {
      color: var(--mint);
      text-decoration: none;
    }
    .cs-kind {
      margin: 8px 0 0;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.03em;
      color: var(--grey-1);
    }
    .cs-oneliner {
      margin: 18px 0 0;
      color: var(--paper);
      max-width: 22ch;
      font-size: clamp(28px, 4.8vw, 46px);
    }
    .cs-standfirst {
      margin: 20px 0 0;
      font-size: 17px;
      line-height: 1.65;
      color: var(--grey-1);
    }
    .dl {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: var(--space-3);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      background: var(--mint);
      border: 2px solid var(--mint);
      padding: 10px 16px;
      text-decoration: none;
    }
    .dl:hover {
      background: var(--paper);
      border-color: var(--paper);
      color: var(--ink);
    }

    /* ── Hero band (cropped strip, like the source) ─────── */
    .cs-hero-wrap {
      margin-top: calc(var(--space-5) * -1);
    }
    .cs-hero {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      overflow: hidden;
      aspect-ratio: 21 / 9;
      background: var(--canvas);
    }
    .cs-hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ── Body ───────────────────────────────────────────── */
    .cs-body {
      padding-block: var(--space-5) var(--space-5);
    }
    .whatibuilt {
      border: var(--border);
      background: var(--surface-card);
      box-shadow: var(--shadow-hard);
      padding: 28px 30px;
    }
    .whatibuilt ul {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 10px;
    }
    .whatibuilt li {
      position: relative;
      padding-left: 22px;
      font-size: 16px;
      line-height: 1.5;
    }
    .whatibuilt li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      width: 8px;
      height: 8px;
      background: var(--teal);
    }

    .beat {
      padding: var(--space-5) 0;
      border-top: var(--rule-dotted);
      margin-top: var(--space-5);
    }
    .beat:first-of-type {
      border-top: none;
    }
    .beat__head {
      display: flex;
      gap: 20px;
      align-items: baseline;
      margin-bottom: var(--space-2);
    }
    .beat__n {
      font-family: var(--font-label);
      font-size: 24px;
      color: var(--teal);
      flex: none;
    }
    .beat__title {
      margin: 0;
      font-size: clamp(24px, 3.5vw, 32px);
    }
    .beat__subhead {
      margin: 8px 0 0;
      font-size: 17px;
      line-height: 1.5;
      color: var(--grey-3);
      font-weight: 600;
    }
    .beat__body p {
      margin: 0 0 14px;
      font-size: 16px;
      line-height: 1.7;
    }

    /* ── Figures ────────────────────────────────────────── */
    .fig {
      margin: var(--space-3) 0 0;
    }
    .fig figcaption {
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.5;
      color: var(--grey-2);
    }

    .fig__grid {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      overflow: hidden;
      display: grid;
      grid-template-columns: var(--cols);
      gap: 12px;
      height: clamp(220px, 32vw, 360px);
    }
    .fig__cell {
      overflow: hidden;
    }
    .fig__cell img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .fig__frame {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
    }
    .fig__framepad {
      padding: clamp(24px, 4vw, 48px);
      background: #f1ede2;
    }
    .fig__framepad img {
      width: 100%;
      display: block;
    }

    .fig__pq {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      overflow: hidden;
      display: grid;
      grid-template-columns: var(--cols);
    }
    .fig__pqimg {
      overflow: hidden;
      border-right: var(--border);
    }
    .fig__pqimg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 220px;
    }
    .fig__pqquote {
      margin: 0;
      padding: clamp(24px, 3vw, 36px);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .fig__pqtext {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(20px, 2.4vw, 26px);
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .fig__pqattrib {
      margin: 14px 0 0;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--grey-2);
    }
    .fig__pqnote {
      margin: 10px 0 0;
      font-size: 13px;
      color: var(--grey-3);
    }

    .fig__band {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      overflow: hidden;
      aspect-ratio: 21 / 9;
    }
    .fig__band img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ── Pull-quote (standalone) ────────────────────────── */
    .pull {
      margin: var(--space-3) 0 0;
      border-left: 4px solid var(--teal);
      padding: 6px 0 6px 20px;
      max-width: 48ch;
    }
    .pull blockquote {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .pull figcaption {
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--grey-2);
    }
    .pull__note {
      margin: 6px 0 0;
      font-size: 13px;
      color: var(--grey-3);
    }

    /* ── Powernaut embedded diagrams ────────────────────── */
    .pn-figure {
      margin: var(--space-3) 0 0;
      max-width: 100%;
      overflow-x: auto;
    }
    .pn-figure :global(figure) {
      margin: 0;
    }
    .pn-figure :global(img) {
      max-width: 100%;
      height: auto;
    }

    /* ── Depth ──────────────────────────────────────────── */
    .depth {
      padding: var(--space-5) 0 0;
      border-top: var(--border);
      margin-top: var(--space-5);
    }
    .depth__title {
      margin: 0 0 var(--space-3);
      font-size: 24px;
    }
    .depth__cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2);
    }
    .dcard {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      display: flex;
      flex-direction: column;
    }
    .dcard__img {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-bottom: var(--border);
    }
    .dcard__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .dcard__body {
      margin: 0;
      padding: 22px 24px;
      font-size: 14px;
      line-height: 1.65;
      color: var(--grey-4);
    }
    .depth__notes {
      margin-top: var(--space-3);
      display: grid;
      gap: 16px;
    }
    .depth__notes p {
      margin: 0;
      font-size: 15.5px;
      line-height: 1.7;
      color: var(--grey-4);
    }

    .cs-next {
      display: flex;
      justify-content: space-between;
      gap: var(--space-2);
      margin-top: var(--space-7);
      padding-top: var(--space-3);
      border-top: var(--rule-dotted);
      flex-wrap: wrap;
    }
    .cs-next a {
      font-family: var(--font-mono);
      font-size: 14px;
      text-decoration: none;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 680px) {
      .fig__grid {
        grid-template-columns: 1fr;
        height: auto;
      }
      .fig__cell {
        aspect-ratio: 3 / 2;
      }
      .fig__pq {
        grid-template-columns: 1fr;
      }
      .fig__pqimg {
        border-right: none;
        border-bottom: var(--border);
        aspect-ratio: 3 / 2;
      }
      .depth__cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
