---
import sharp from 'sharp';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { caseStudies, type Figure, type Img } from '../../data/caseStudies';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props;
const isPowernaut = cs.slug === 'powernaut';
const imgStyle = (im: Img) => (im.fit ? `object-fit:${im.fit}` : '');

// Build-time aspect ratios so paired images render as a justified row —
// equal height, widths proportional to each image (matches the PDF layout).
async function aspectRatio(src: string): Promise<number> {
  try {
    const meta = await sharp(path.join(process.cwd(), 'public', src)).metadata();
    return meta.width && meta.height ? meta.width / meta.height : 1;
  } catch {
    return 1;
  }
}
const gridSrcs = new Set<string>();
for (const beat of cs.beats)
  for (const fig of beat.figures ?? [])
    if (fig.layout === 'grid') for (const im of fig.imgs) gridSrcs.add(im.src);
const arMap: Record<string, number> = {};
for (const src of gridSrcs) arMap[src] = await aspectRatio(src);
---

<BaseLayout title={`${cs.name} — Hayden Slaughter`} description={cs.oneLiner}>
  <SiteNav />

  <main>
    <header class="cs-head">
      <div class="doc">
        <p class="eyebrow"><a href="/portfolio" class="cs-back">← Portfolio</a></p>
        <p class="cs-kind">{cs.roleTitle} · {cs.name} · {cs.kind} · {cs.period}</p>
        <h1 class="cs-oneliner">{cs.oneLiner}</h1>
        <p class="cs-standfirst">{cs.standfirst}</p>
        <a class="dl" href="/Hayden-Slaughter-Portfolio.pdf" download>
          <span class="dl__icon">↓</span> Download portfolio (PDF)
        </a>
      </div>
    </header>

    <div class="doc cs-body">
      {
        isPowernaut && (
          <div class="fig__diagram cs-diagram-hero">
            <img
              src="/portfolio/img/pn-hero.png"
              alt="The Powernaut product strategy in one shape — assets, operations and markets around one shared data core"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }
      {
        cs.hero && (
          <div class="cs-hero">
            <img src={cs.hero.src} alt={cs.hero.alt} loading="lazy" />
          </div>
        )
      }

      <section class="whatibuilt">
        <p class="eyebrow">What I built</p>
        <ul>
          {cs.whatIBuilt.map((w) => <li>{w}</li>)}
        </ul>
      </section>

      {
        cs.beats.map((beat, i) => (
          <section class="beat">
            <span class="beat__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="beat__head">
              <h2 class="beat__title">{beat.title}</h2>
              <p class="beat__subhead">{beat.subhead}</p>
            </div>
            <div class="beat__body">
              {beat.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            {beat.quote && (
              <figure class="pull">
                <blockquote>{beat.quote.text}</blockquote>
                {beat.quote.attrib && <figcaption>{beat.quote.attrib}</figcaption>}
                {beat.quote.note && <p class="pull__note">{beat.quote.note}</p>}
              </figure>
            )}

            {beat.figures?.map((fig: Figure) => (
              <figure class="fig">
                {fig.layout === 'grid' && (
                  <div class="fig__grid">
                    {fig.imgs.map((im) => (
                      <div
                        class="fig__cell"
                        style={`flex:${(arMap[im.src] ?? 1).toFixed(4)} 1 0;${im.bg ? `background:${im.bg}` : ''}`}
                      >
                        <img src={im.src} alt={im.alt} style={imgStyle(im)} loading="lazy" decoding="async" />
                      </div>
                    ))}
                  </div>
                )}

                {fig.layout === 'frame' && (
                  <div class="fig__frame">
                    <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                  </div>
                )}

                {fig.layout === 'photo' && (
                  <div class="fig__photo">
                    <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                  </div>
                )}

                {fig.layout === 'diagram' && (
                  <div class="fig__diagram">
                    <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                  </div>
                )}

                {fig.layout === 'photo-quote' && (
                  <div class="fig__pq" style={`--cols:${fig.cols ?? '0.55fr 1fr'}`}>
                    <div class="fig__pqimg">
                      <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                    </div>
                    <blockquote class="fig__pqquote">
                      <p class="fig__pqtext">{fig.quote?.text}</p>
                      {fig.quote?.attrib && <p class="fig__pqattrib">{fig.quote.attrib}</p>}
                      {fig.quote?.note && <p class="fig__pqnote">{fig.quote.note}</p>}
                    </blockquote>
                  </div>
                )}

                {fig.caption && <figcaption>{fig.caption}</figcaption>}
              </figure>
            ))}

            {beat.stat && (
              <div class="statbar">
                {beat.stat.map((s) => <span class="statbar__seg">{s}</span>)}
              </div>
            )}

          </section>
        ))
      }

      {
        cs.depth && cs.depth.length > 0 && (
          <section class="depth">
            <h2 class="depth__title">{cs.depthHeading}</h2>
            <div class="depth__grid">
              {cs.depth.map((d) => (
                <article class="dcard">
                  {d.image && (
                    <div class="dcard__img">
                      <img src={d.image.src} alt={d.image.alt} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <div class="dcard__body">
                    <h3>{d.title}</h3>
                    <p>{d.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <nav class="cs-next">
        <a href="/portfolio">← Portfolio</a>
        <a href="/">The CV →</a>
      </nav>
    </div>
  </main>

  <SiteFooter />

  <style>
    /* Unified document column (matches the PDF: text and images share one width) */
    .doc {
      width: 100%;
      max-width: var(--page-max);
      margin-inline: auto;
      padding-inline: 24px;
      box-sizing: border-box;
    }

    /* ── Header ─────────────────────────────────────────── */
    .cs-head {
      background: var(--ink);
      color: var(--paper);
      padding-block: var(--space-7) var(--space-5);
    }
    .cs-back {
      color: var(--mint);
      text-decoration: none;
    }
    .cs-kind {
      margin: 8px 0 0;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.03em;
      color: var(--grey-1);
    }
    .cs-oneliner {
      margin: 18px 0 0;
      color: var(--paper);
      font-size: clamp(30px, 5vw, 46px);
    }
    .cs-standfirst {
      margin: 20px 0 0;
      font-size: 17px;
      line-height: 1.6;
      color: var(--grey-1);
      max-width: 60ch;
    }
    .dl {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: var(--space-3);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      background: var(--mint);
      border: 2px solid var(--mint);
      padding: 10px 16px;
      text-decoration: none;
    }
    .dl:hover {
      background: var(--paper);
      border-color: var(--paper);
      color: var(--ink);
    }

    /* ── Body ───────────────────────────────────────────── */
    .cs-body {
      padding-block: var(--space-5) var(--space-7);
    }

    .cs-hero {
      margin-top: var(--space-3);
      border: var(--border);
      box-shadow: var(--shadow-hard);
      overflow: hidden;
      background: var(--canvas);
    }
    .cs-hero img {
      width: 100%;
      display: block;
      max-height: 460px;
      object-fit: cover;
    }

    .whatibuilt {
      margin-top: var(--space-5);
    }
    .whatibuilt ul {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }
    .whatibuilt li {
      position: relative;
      padding-left: 22px;
      font-size: 16px;
      line-height: 1.5;
    }
    .whatibuilt li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      width: 8px;
      height: 8px;
      background: var(--teal);
    }

    /* ── Beats (number hangs in the gutter, text aligns to it) ── */
    .beat {
      position: relative;
      padding-top: var(--space-7);
      padding-left: 46px;
    }
    .beat__head {
      margin-bottom: var(--space-2);
    }
    .beat__n {
      position: absolute;
      left: 0;
      top: calc(var(--space-7) + 5px);
      font-family: var(--font-label);
      font-size: 20px;
      color: var(--teal);
    }
    .beat__title {
      margin: 0;
      font-size: clamp(24px, 3.5vw, 30px);
    }
    .beat__subhead {
      margin: 10px 0 0;
      font-size: 17px;
      line-height: 1.45;
      color: var(--ink);
      font-weight: 600;
    }
    .beat__body {
      margin-top: 16px;
    }
    .beat__body p {
      margin: 0 0 14px;
      font-size: 16px;
      line-height: 1.75;
    }
    .beat__body p:last-child {
      margin-bottom: 0;
    }

    /* ── Figures ────────────────────────────────────────── */
    .fig {
      margin: var(--space-3) 0 0;
    }
    .fig figcaption {
      margin-top: 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.5;
      color: var(--grey-2);
    }

    /* Powernaut diagrams: pre-rendered PNGs with their frame baked in, so the
       wrapper adds none of its own — just scale the image to the column. */
    .fig__diagram img {
      width: 100%;
      height: auto;
      display: block;
    }
    .cs-diagram-hero {
      margin-top: var(--space-3);
    }

    /* Paired images as a justified row — equal height, widths proportional to
       each image's aspect ratio, each in its own frame (matches the PDF). */
    .fig__grid {
      display: flex;
      gap: 22px;
      align-items: flex-start;
    }
    .fig__cell {
      flex: 1 1 0; /* overridden inline with the image's aspect ratio */
      min-width: 0;
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      overflow: hidden;
    }
    .fig__cell img {
      width: 100%;
      height: auto;
      display: block;
    }

    .fig__frame {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: #f1ede2;
      padding: clamp(20px, 4vw, 44px);
    }
    .fig__frame img {
      width: 100%;
      display: block;
    }

    /* Full-bleed photo: fills the box edge to edge, whole image, no padding */
    .fig__photo {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      overflow: hidden;
      background: var(--canvas);
    }
    .fig__photo img {
      width: 100%;
      display: block;
    }

    .fig__pq {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      overflow: hidden;
      display: grid;
      grid-template-columns: var(--cols);
    }
    .fig__pqimg {
      overflow: hidden;
      border-right: var(--border);
    }
    .fig__pqimg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 240px;
    }
    .fig__pqquote {
      margin: 0;
      padding: clamp(22px, 3vw, 34px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: var(--ink);
      color: var(--paper);
    }
    .fig__pqtext {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(19px, 2.4vw, 24px);
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .fig__pqattrib {
      margin: 14px 0 0;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--mint);
    }
    .fig__pqnote {
      margin: 10px 0 0;
      font-size: 13px;
      color: var(--grey-1);
    }

    /* ── Stat bar ───────────────────────────────────────── */
    .statbar {
      margin-top: var(--space-3);
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--mint);
      color: var(--ink);
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .statbar__seg {
      padding: 18px 20px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 15px;
      text-align: center;
    }
    .statbar__seg + .statbar__seg {
      border-left: var(--border);
    }

    /* ── Pull-quote (standalone) ────────────────────────── */
    .pull {
      margin: var(--space-3) 0 0;
      border-left: 4px solid var(--teal);
      padding: 6px 0 6px 20px;
    }
    .pull blockquote {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .pull figcaption {
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--grey-2);
    }
    .pull__note {
      margin: 6px 0 0;
      font-size: 13px;
      color: var(--grey-3);
    }

    /* ── Depth (boxed cards) ────────────────────────────── */
    .depth {
      padding-top: var(--space-7);
    }
    .depth__title {
      margin: 0 0 var(--space-3);
      font-size: clamp(24px, 3.5vw, 30px);
    }
    .depth__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .dcard {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      display: flex;
      flex-direction: column;
    }
    .dcard__img {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-bottom: var(--border);
    }
    .dcard__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .dcard__body {
      padding: 22px 24px;
    }
    .dcard__body h3 {
      margin: 0 0 8px;
      font-size: 17px;
      letter-spacing: -0.01em;
    }
    .dcard__body p {
      margin: 0;
      font-size: 14px;
      line-height: 1.65;
      color: var(--grey-4);
    }

    .cs-next {
      display: flex;
      justify-content: space-between;
      gap: var(--space-2);
      margin-top: var(--space-7);
      padding-top: var(--space-3);
      border-top: var(--rule-dotted);
      flex-wrap: wrap;
    }
    .cs-next a {
      font-family: var(--font-mono);
      font-size: 14px;
      text-decoration: none;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 640px) {
      .fig__grid {
        flex-direction: column;
      }
      .fig__cell {
        flex: 0 0 auto; /* stack full-width, natural height */
      }
      .fig__pq {
        grid-template-columns: 1fr;
      }
      .fig__pqimg {
        border-right: none;
        border-bottom: var(--border);
        aspect-ratio: 3 / 2;
      }
      .statbar {
        grid-auto-flow: row;
      }
      .statbar__seg + .statbar__seg {
        border-left: none;
        border-top: var(--border);
      }
      .depth__grid {
        grid-template-columns: 1fr;
      }
      /* Drop the hanging-number indent — number sits inline above the title */
      .beat {
        padding-left: 0;
      }
      .beat__n {
        position: static;
        display: block;
        margin-bottom: 8px;
      }
    }
  </style>
</BaseLayout>
