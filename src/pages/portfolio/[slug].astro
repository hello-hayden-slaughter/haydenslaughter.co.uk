---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { caseStudies, type Figure, type Img } from '../../data/caseStudies';

// Powernaut is diagram-led; its figures are inline SVG/HTML lifted from source.
import pnHero from '../../diagrams/powernaut/hero.html?raw';
import pnFig1 from '../../diagrams/powernaut/fig1.html?raw';
import pnFig2 from '../../diagrams/powernaut/fig2.html?raw';
import pnFig3 from '../../diagrams/powernaut/fig3.html?raw';
import pnFig4 from '../../diagrams/powernaut/fig4.html?raw';
import pnFig5 from '../../diagrams/powernaut/fig5.html?raw';
import pnFig6 from '../../diagrams/powernaut/fig6.html?raw';
import pnFig7 from '../../diagrams/powernaut/fig7.html?raw';

const powernautDiagrams: Record<number, string[]> = {
  0: [pnFig1],
  1: [pnFig2],
  2: [pnFig3],
  3: [pnFig4, pnFig5],
  4: [pnFig6],
  5: [pnFig7],
};

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}

const { cs } = Astro.props;
const isPowernaut = cs.slug === 'powernaut';
const diagramsFor = (idx: number): string[] => (isPowernaut ? (powernautDiagrams[idx] ?? []) : []);
const imgStyle = (im: Img) => (im.fit ? `object-fit:${im.fit}` : '');
---

<BaseLayout title={`${cs.name} — Hayden Slaughter`} description={cs.oneLiner}>
  <SiteNav />

  <main>
    <header class="cs-head">
      <div class="doc">
        <p class="eyebrow"><a href="/portfolio" class="cs-back">← Portfolio</a></p>
        <p class="cs-kind">{cs.roleTitle} · {cs.name} · {cs.kind} · {cs.period}</p>
        <h1 class="cs-oneliner">{cs.oneLiner}</h1>
        <p class="cs-standfirst">{cs.standfirst}</p>
        <a class="dl" href="/Hayden-Slaughter-Portfolio.pdf" download>
          <span class="dl__icon">↓</span> Download portfolio (PDF)
        </a>
      </div>
    </header>

    <div class="doc cs-body">
      {
        isPowernaut && (
          <div class="pn-figure pn-hero" set:html={pnHero} />
        )
      }
      {
        cs.hero && (
          <div class="cs-hero">
            <img src={cs.hero.src} alt={cs.hero.alt} loading="lazy" />
          </div>
        )
      }

      <section class="whatibuilt">
        <p class="eyebrow">What I built</p>
        <ul>
          {cs.whatIBuilt.map((w) => <li>{w}</li>)}
        </ul>
      </section>

      {
        cs.beats.map((beat, i) => (
          <section class="beat">
            <span class="beat__n">{String(i + 1).padStart(2, '0')}</span>
            <div class="beat__head">
              <h2 class="beat__title">{beat.title}</h2>
              <p class="beat__subhead">{beat.subhead}</p>
            </div>
            <div class="beat__body">
              {beat.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>

            {beat.quote && (
              <figure class="pull">
                <blockquote>{beat.quote.text}</blockquote>
                {beat.quote.attrib && <figcaption>{beat.quote.attrib}</figcaption>}
                {beat.quote.note && <p class="pull__note">{beat.quote.note}</p>}
              </figure>
            )}

            {beat.figures?.map((fig: Figure) => (
              <figure class="fig">
                {fig.layout === 'grid' && (
                  <div
                    class:list={['fig__grid', { 'fig__grid--contain': fig.imgs.some((im) => im.fit === 'contain') }]}
                    style={`--cols:${fig.cols ?? '1fr 1fr'}`}
                  >
                    {fig.imgs.map((im) => (
                      <div class="fig__cell" style={im.bg ? `background:${im.bg}` : ''}>
                        <img src={im.src} alt={im.alt} style={imgStyle(im)} loading="lazy" decoding="async" />
                      </div>
                    ))}
                  </div>
                )}

                {fig.layout === 'frame' && (
                  <div class="fig__frame">
                    <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                  </div>
                )}

                {fig.layout === 'photo' && (
                  <div class="fig__photo">
                    <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                  </div>
                )}

                {fig.layout === 'photo-quote' && (
                  <div class="fig__pq" style={`--cols:${fig.cols ?? '0.55fr 1fr'}`}>
                    <div class="fig__pqimg">
                      <img src={fig.imgs[0].src} alt={fig.imgs[0].alt} loading="lazy" decoding="async" />
                    </div>
                    <blockquote class="fig__pqquote">
                      <p class="fig__pqtext">{fig.quote?.text}</p>
                      {fig.quote?.attrib && <p class="fig__pqattrib">{fig.quote.attrib}</p>}
                      {fig.quote?.note && <p class="fig__pqnote">{fig.quote.note}</p>}
                    </blockquote>
                  </div>
                )}

                {fig.caption && <figcaption>{fig.caption}</figcaption>}
              </figure>
            ))}

            {beat.stat && (
              <div class="statbar">
                {beat.stat.map((s) => <span class="statbar__seg">{s}</span>)}
              </div>
            )}

            {diagramsFor(i).length === 2 ? (
              <div class="pn-grid">
                {diagramsFor(i).map((d) => <div class="pn-figure" set:html={d} />)}
              </div>
            ) : (
              diagramsFor(i).map((d) => <div class="pn-figure" set:html={d} />)
            )}
          </section>
        ))
      }

      {
        cs.depth && cs.depth.length > 0 && (
          <section class="depth">
            <h2 class="depth__title">{cs.depthHeading}</h2>
            <div class="depth__grid">
              {cs.depth.map((d) => (
                <article class="dcard">
                  {d.image && (
                    <div class="dcard__img">
                      <img src={d.image.src} alt={d.image.alt} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <div class="dcard__body">
                    <h3>{d.title}</h3>
                    <p>{d.body}</p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }

      <nav class="cs-next">
        <a href="/portfolio">← Portfolio</a>
        <a href="/">The CV →</a>
      </nav>
    </div>
  </main>

  <SiteFooter />

  <style>
    /* Unified document column (matches the PDF: text and images share one width) */
    .doc {
      width: 100%;
      max-width: var(--page-max);
      margin-inline: auto;
      padding-inline: 24px;
      box-sizing: border-box;
    }

    /* ── Header ─────────────────────────────────────────── */
    .cs-head {
      background: var(--ink);
      color: var(--paper);
      padding-block: var(--space-7) var(--space-5);
    }
    .cs-back {
      color: var(--mint);
      text-decoration: none;
    }
    .cs-kind {
      margin: 8px 0 0;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.03em;
      color: var(--grey-1);
    }
    .cs-oneliner {
      margin: 18px 0 0;
      color: var(--paper);
      font-size: clamp(30px, 5vw, 46px);
    }
    .cs-standfirst {
      margin: 20px 0 0;
      font-size: 17px;
      line-height: 1.6;
      color: var(--grey-1);
      max-width: 60ch;
    }
    .dl {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: var(--space-3);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      background: var(--mint);
      border: 2px solid var(--mint);
      padding: 10px 16px;
      text-decoration: none;
    }
    .dl:hover {
      background: var(--paper);
      border-color: var(--paper);
      color: var(--ink);
    }

    /* ── Body ───────────────────────────────────────────── */
    .cs-body {
      padding-block: var(--space-5) var(--space-7);
    }

    .cs-hero {
      margin-top: var(--space-3);
      border: var(--border);
      box-shadow: var(--shadow-hard);
      overflow: hidden;
      background: var(--canvas);
    }
    .cs-hero img {
      width: 100%;
      display: block;
      max-height: 460px;
      object-fit: cover;
    }

    .whatibuilt {
      margin-top: var(--space-5);
    }
    .whatibuilt ul {
      margin: 14px 0 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }
    .whatibuilt li {
      position: relative;
      padding-left: 22px;
      font-size: 16px;
      line-height: 1.5;
    }
    .whatibuilt li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      width: 8px;
      height: 8px;
      background: var(--teal);
    }

    /* ── Beats (number hangs in the gutter, text aligns to it) ── */
    .beat {
      position: relative;
      padding-top: var(--space-7);
      padding-left: 46px;
    }
    .beat__head {
      margin-bottom: var(--space-2);
    }
    .beat__n {
      position: absolute;
      left: 0;
      top: calc(var(--space-7) + 5px);
      font-family: var(--font-label);
      font-size: 20px;
      color: var(--teal);
    }
    .beat__title {
      margin: 0;
      font-size: clamp(24px, 3.5vw, 30px);
    }
    .beat__subhead {
      margin: 10px 0 0;
      font-size: 17px;
      line-height: 1.45;
      color: var(--ink);
      font-weight: 600;
    }
    .beat__body {
      margin-top: 16px;
    }
    .beat__body p {
      margin: 0 0 14px;
      font-size: 16px;
      line-height: 1.75;
    }
    .beat__body p:last-child {
      margin-bottom: 0;
    }

    /* ── Figures ────────────────────────────────────────── */
    .fig {
      margin: var(--space-3) 0 0;
    }
    .fig figcaption,
    .pn-figure + figcaption {
      margin-top: 12px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.5;
      color: var(--grey-2);
    }

    /* Two images side by side, each shown WHOLE (natural aspect, no cropping) */
    .fig__grid {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      overflow: hidden;
      display: grid;
      grid-template-columns: var(--cols);
      gap: 18px;
      align-items: start;
    }
    .fig__cell {
      overflow: hidden;
    }
    .fig__cell img {
      width: 100%;
      height: auto;
      display: block;
    }

    .fig__frame {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: #f1ede2;
      padding: clamp(20px, 4vw, 44px);
    }
    .fig__frame img {
      width: 100%;
      display: block;
    }

    /* Full-bleed photo: fills the box edge to edge, whole image, no padding */
    .fig__photo {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      overflow: hidden;
      background: var(--canvas);
    }
    .fig__photo img {
      width: 100%;
      display: block;
    }

    .fig__pq {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      overflow: hidden;
      display: grid;
      grid-template-columns: var(--cols);
    }
    .fig__pqimg {
      overflow: hidden;
      border-right: var(--border);
    }
    .fig__pqimg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 240px;
    }
    .fig__pqquote {
      margin: 0;
      padding: clamp(22px, 3vw, 34px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: var(--ink);
      color: var(--paper);
    }
    .fig__pqtext {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(19px, 2.4vw, 24px);
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .fig__pqattrib {
      margin: 14px 0 0;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--mint);
    }
    .fig__pqnote {
      margin: 10px 0 0;
      font-size: 13px;
      color: var(--grey-1);
    }

    /* ── Stat bar ───────────────────────────────────────── */
    .statbar {
      margin-top: var(--space-3);
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--mint);
      color: var(--ink);
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }
    .statbar__seg {
      padding: 18px 20px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 15px;
      text-align: center;
    }
    .statbar__seg + .statbar__seg {
      border-left: var(--border);
    }

    /* ── Pull-quote (standalone) ────────────────────────── */
    .pull {
      margin: var(--space-3) 0 0;
      border-left: 4px solid var(--teal);
      padding: 6px 0 6px 20px;
    }
    .pull blockquote {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 24px;
      line-height: 1.3;
      letter-spacing: -0.01em;
    }
    .pull figcaption {
      margin-top: 10px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--grey-2);
    }
    .pull__note {
      margin: 6px 0 0;
      font-size: 13px;
      color: var(--grey-3);
    }

    /* ── Powernaut embedded diagrams ────────────────────── */
    .pn-hero {
      margin: var(--space-3) 0 0;
    }
    .pn-figure {
      margin: var(--space-3) 0 0;
      max-width: 100%;
      overflow-x: auto;
    }
    .pn-figure :global(figure) {
      margin: 0;
    }
    .pn-figure :global(img) {
      max-width: 100%;
      height: auto;
    }
    .pn-grid {
      margin: var(--space-3) 0 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      align-items: stretch;
    }
    .pn-grid .pn-figure {
      margin: 0;
      display: flex;
    }
    .pn-grid .pn-figure :global(> figure) {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .pn-grid .pn-figure :global(> figure > div) {
      flex: 1;
    }

    /* ── Depth (boxed cards) ────────────────────────────── */
    .depth {
      padding-top: var(--space-7);
    }
    .depth__title {
      margin: 0 0 var(--space-3);
      font-size: clamp(24px, 3.5vw, 30px);
    }
    .depth__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
    .dcard {
      border: var(--border);
      box-shadow: var(--shadow-hard);
      background: var(--paper);
      display: flex;
      flex-direction: column;
    }
    .dcard__img {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-bottom: var(--border);
    }
    .dcard__img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .dcard__body {
      padding: 22px 24px;
    }
    .dcard__body h3 {
      margin: 0 0 8px;
      font-size: 17px;
      letter-spacing: -0.01em;
    }
    .dcard__body p {
      margin: 0;
      font-size: 14px;
      line-height: 1.65;
      color: var(--grey-4);
    }

    .cs-next {
      display: flex;
      justify-content: space-between;
      gap: var(--space-2);
      margin-top: var(--space-7);
      padding-top: var(--space-3);
      border-top: var(--rule-dotted);
      flex-wrap: wrap;
    }
    .cs-next a {
      font-family: var(--font-mono);
      font-size: 14px;
      text-decoration: none;
    }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 640px) {
      .fig__grid {
        grid-template-columns: 1fr;
      }
      .fig__pq {
        grid-template-columns: 1fr;
      }
      .fig__pqimg {
        border-right: none;
        border-bottom: var(--border);
        aspect-ratio: 3 / 2;
      }
      .statbar {
        grid-auto-flow: row;
      }
      .statbar__seg + .statbar__seg {
        border-left: none;
        border-top: var(--border);
      }
      .pn-grid,
      .depth__grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
