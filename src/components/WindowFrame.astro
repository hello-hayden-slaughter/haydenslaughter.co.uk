---
// OS-register (Register A) window chrome — presentational shell.
// The interactive window manager (Preact, issue #3) will wrap this behaviour;
// this static version is used for the styleguide and non-interactive contexts.
interface Props {
  title?: string;
  menus?: string[];
  width?: string | number;
  height?: string | number;
  class?: string;
}

const {
  title = 'UNTITLED',
  menus = ['FILE', 'HELP'],
  width,
  height,
  class: className,
} = Astro.props;

const dim = (v: string | number | undefined) =>
  v === undefined ? undefined : typeof v === 'number' ? `${v}px` : v;
const frameStyle = [
  width !== undefined ? `width:${dim(width)}` : '',
  height !== undefined ? `height:${dim(height)}` : '',
]
  .filter(Boolean)
  .join(';');
---

<div class:list={['win', className]} style={frameStyle}>
  <div class="win__titlebar">
    <span class="win__title">{title}</span>
    <span class="win__controls">
      <button class="win__btn" type="button" aria-label="Minimise">_</button>
      <button class="win__btn" type="button" aria-label="Close">X</button>
    </span>
  </div>
  <div class="win__menubar">
    {menus.map((m) => <button class="win__menu" type="button">{m}</button>)}
  </div>
  <div class="win__body"><slot /></div>
</div>

<style>
  .win {
    border: var(--border);
    background: var(--paper);
    box-shadow: var(--shadow-os);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .win__titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--navy);
    color: #ffffff;
    padding: 6px 8px;
    user-select: none;
    flex-shrink: 0;
  }
  .win__title {
    font-family: var(--font-label);
    font-size: 11px;
  }
  .win__controls {
    display: flex;
    gap: 4px;
  }
  .win__btn {
    appearance: none;
    width: 22px;
    height: 20px;
    background: var(--grey-1);
    border: 2px solid;
    border-color: var(--bevel-raised);
    font-family: var(--font-label);
    font-size: 9px;
    cursor: pointer;
    line-height: 1;
    color: var(--ink);
    padding: 0;
  }
  .win__btn:active {
    border-color: var(--bevel-sunken);
  }
  .win__menubar {
    display: flex;
    gap: 2px;
    background: var(--grey-1);
    border-bottom: 2px solid var(--grey-4);
    padding: 2px 6px;
    flex-shrink: 0;
  }
  .win__menu {
    appearance: none;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-label);
    font-size: 9px;
    padding: 4px 8px;
    color: var(--ink);
  }
  .win__menu:hover {
    background: var(--navy);
    color: #ffffff;
  }
  .win__body {
    padding: 20px 22px;
    overflow: auto;
    flex: 1;
    min-height: 0;
    font-family: var(--font-os);
    font-size: 13.5px;
    line-height: 1.7;
  }
</style>
